{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yoshirian",
  "version": "../package.json",
  "identifier": "dev.yoshirian.manager",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "npm run sync-assets",
    "beforeBuildCommand": "npm run sync-assets"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Yoshirian",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../assets/icons/32x32.png",
      "../assets/icons/128x128.png",
      "../assets/icons/128x128@2x.png",
      "../assets/icons/icon.png",
      "../assets/icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "Yoshirian"
      }
    },
    "shortDescription": "Deadlock mod manager"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "yoshirian"
        ]
      }
    }
  }
}